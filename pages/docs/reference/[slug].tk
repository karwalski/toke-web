m=page.docs.reference.slug;
i=http:std.http;
i=tpl:ooke.template;
i=store:ooke.store;

f=get(req:i64):i64{
  let slug=req.param("slug");
  let result=store.slug("docs/reference"; slug);
  match result{
    ok(page){
      <tpl.renderfile("templates/docs/reference.tkt"; @("page.title":page.title; "body":page.body; "slug":slug; "site.name":"toke"))
    };
    err(e){
      <http.resstatus(404; "<!DOCTYPE html><html><body><h1>404 Not Found</h1><p>No reference page for <code>std."+slug+"</code>.</p></body></html>")
    }
  }
};

m=page.docs.tutorials.slug;
i=http:std.http;
i=tpl:ooke.template;
i=store:ooke.store;

f=get(req:i64):i64{
  let slug=req.param("slug");
  let result=store.slug("docs/tutorials"; slug);
  match result{
    ok(page){
      <tpl.renderfile("templates/docs/tutorials/[slug].tkt"; @("title":page.meta.get("title"); "description":page.meta.get("description"); "body":page.body; "slug":slug; "site.name":"toke"))
    };
    err(e){
      <http.resstatus(404; "<!DOCTYPE html><html><body><h1>404 Not Found</h1><p>No tutorials page for <code>"+slug+"</code>.</p></body></html>")
    }
  }
};

m=website;
i=http:std.http;
i=log:std.log;
i=args:std.args;
i=str:std.str;
i=file:std.file;

f=healthjson():$str{
  <"{\"status\":\"ok\",\"version\":\"0.3.0\",\"service\":\"toke-website\"}"
};

f=main():i64{
  log.openaccess("logs/access.log"; 10000; 30; 0);
  let port=mut.443 as u64;
  let httpmode=mut.false;
  let argc=args.count();
  lp(let i=1;i<(argc as i64);i=i+1){
    let arg=args.get(i as u64);
    if(arg=="--http"){httpmode=true};
    if(arg=="--port"){
      let nxt=args.get((i+1) as u64);
      let pv=mt str.toint(nxt) {$ok:n n;$err:e 443};
      port=pv as u64;
      i=i+1;
    }
  };
  let hj=healthjson();
  let llms=mt file.read("sites/tokelang.dev/llms.txt"){$ok:t t;$err:e ""};
  http.getstaticmime("/llms.txt";llms;"text/plain; charset=utf-8");
  http.getstaticmime("/health";hj;"application/json");
  http.getstaticmime("/api/health";hj;"application/json");
  http.getstatic("/api/version";"{\"version\":\"0.3.0\"}");
  (* Routing is host-independent: servepages registers a named route per
     templates/*.tkt, and servedir("/") is the wildcard fallback over build/.
     Every host the server answers for gets the same tree (story 132.21). *)
  http.servepages("templates";"templates");
  http.servedir("/";"build");
  if(httpmode){http.serveworkers(port;2)};
  if(httpmode==false){http.servetls(port;"certs/cert.pem";"certs/key.pem")};
  <0
};

m=website;
i=http:std.http;
i=log:std.log;
i=args:std.args;
i=str:std.str;
i=file:std.file;

f=healthjson():$str{
  <"{\"status\":\"ok\",\"version\":\"0.3.0\",\"service\":\"toke-website\"}"
};

f=main():i64{
  log.openaccess("logs/access.log"; 10000; 30; 0);
  let port=mut.443 as u64;
  let httpmode=mut.false;
  let argc=args.count();
  lp(let i=1;i<(argc as i64);i=i+1){
    let arg=args.get(i as u64);
    if(arg="--http"){httpmode=true};
    if(arg="--port"){
      let nxt=args.get((i+1) as u64);
      let pv=mt str.toint(nxt) {$ok:n n;$err:e 443};
      port=pv as u64;
      i=i+1
    }
  };
  http.servedir("/static";"build");
  http.vhost("tokelang.dev";"sites/tokelang.dev");
  http.vhost("www.tokelang.dev";"sites/tokelang.dev");
  http.vhost("staging.tokelang.dev";"sites/tokelang.dev");
  http.vhost("loke.tokelang.dev";"sites/loke.tokelang.dev");
  let hj=healthjson();
  http.getstaticmime("/health";hj;"application/json");
  http.getstaticmime("/api/health";hj;"application/json");
  http.getstatic("/api/version";"{\"version\":\"0.3.0\"}");
  let p0=mt file.read("build/index.html") {$ok:v v;$err:e ""};
  http.getstatic("/";p0);
  let p1=mt file.read("build/docs/index.html") {$ok:va va;$err:ea ""};
  http.getstatic("/docs";p1);
  let p2=mt file.read("build/docs/learn/index.html") {$ok:vb vb;$err:eb ""};
  http.getstatic("/docs/learn";p2);
  let p3=mt file.read("build/docs/learn/06-strings-io/index.html") {$ok:vc vc;$err:ec ""};
  http.getstatic("/docs/learn/06-strings-io";p3);
  let p4=mt file.read("build/docs/about/index/index.html") {$ok:vd vd;$err:ed ""};
  http.getstatic("/about";p4);
  http.getstatic("/docs/about";p4);
  let p5=mt file.read("build/docs/about/why/index.html") {$ok:vf vf;$err:ef ""};
  http.getstatic("/about/why";p5);
  http.getstatic("/docs/about/why";p5);
  let p6=mt file.read("build/docs/about/design/index.html") {$ok:vg vg;$err:eg ""};
  http.getstatic("/about/design";p6);
  http.getstatic("/docs/about/design";p6);
  let p7=mt file.read("build/ecosystem/index.html") {$ok:vh vh;$err:eh ""};
  http.getstatic("/ecosystem";p7);
  let p8=mt file.read("build/loke/index.html") {$ok:vi vi;$err:ei ""};
  http.getstatic("/loke";p8);
  let p9=mt file.read("build/ooke/index.html") {$ok:vj vj;$err:ej ""};
  http.getstatic("/ooke";p9);
  let p10=mt file.read("build/docs/reference/index.html") {$ok:vk vk;$err:ek ""};
  http.getstatic("/docs/reference";p10);
  let cssdata=mt file.read("build/static/css/style.css") {$ok:ve ve;$err:ee ""};
  http.getstaticmime("/static/css/style.css";cssdata;"text/css");
  if(httpmode){http.serveworkers(port;2)};
  if(httpmode=false){http.servevhoststls(port;"certs/cert.pem";"certs/key.pem")};
  <0
};

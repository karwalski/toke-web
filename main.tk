m=website;
i=http:std.http;
i=log:std.log;
i=args:std.args;
i=str:std.str;
i=file:std.file;

(* 132.153 -- what this binary was built from. The two strings below are
   STAMPED at build time by scripts/stamp_main.sh, which every build of the
   binary compiles through (make main.ll, scripts/deploy.sh full): the toke
   version of the tkc that emitted the IR, and the site commit it was emitted
   from. A build that skips the stamp reports "unstamped", never a stale
   number. Do not edit the values by hand. *)
f=tokeversion():$str{<"unstamped"};
f=sitecommit():$str{<"unstamped"};

f=versionfields():$str{
  let a=str.concat("\"version\":\"";tokeversion());
  <str.concat(a;str.concat("\",\"site\":\"";str.concat(sitecommit();"\"")))
};

f=healthjson():$str{
  let b=str.concat("{\"status\":\"ok\",";versionfields());
  <str.concat(b;",\"service\":\"toke-website\"}")
};

f=versionjson():$str{
  <str.concat("{";str.concat(versionfields();"}"))
};

f=main():i64{
  log.openaccess("logs/access.log"; 10000; 30; 0);
  let port=mut.443 as u64;
  let httpmode=mut.false;
  let argc=args.count();
  lp(let i=1;i<(argc as i64);i=i+1){
    let arg=mt args.get(i as u64){$ok:v v;$err:e ""};
    if(arg=="--http"){httpmode=true};
    if(arg=="--port"){
      let pv=mt args.get((i+1) as u64){
        $ok:nxt mt str.toint(nxt){$ok:n n;$err:e 443};
        $err:e 443
      };
      port=pv as u64;
      i=i+1;
    }
  };
  let hj=healthjson();
  let llms=mt file.read("sites/tokelang.dev/llms.txt"){$ok:t t;$err:e ""};
  http.getstaticmime("/llms.txt";llms;"text/plain; charset=utf-8");
  http.getstaticmime("/health";hj;"application/json");
  http.getstaticmime("/api/health";hj;"application/json");
  http.getstatic("/api/version";versionjson());
  (* Routing is host-independent: servepages registers a named route per
     templates/*.tkt, and servedir("/") is the wildcard fallback over build/.
     Every host the server answers for gets the same tree (story 132.21). *)
  http.servepages("templates";"templates");
  http.servedir("/";"build");
  if(httpmode){http.serveworkers(port;2)};
  if(httpmode==false){http.servetls(port;"certs/cert.pem";"certs/key.pem")};
  <0
};

m=website;
i=http:std.http;
i=log:std.log;
i=args:std.args;
i=str:std.str;
i=io:std.io;

f=healthjson():$str{
  <"{\"status\":\"ok\",\"version\":\"0.1.0\",\"service\":\"toke-website\"}"
};

f=main():i64{
  log.openaccess("logs/access.log"; 10000; 30; 0);

  let port=mut.443 as u64;
  let httpmode=mut.false;
  let argc=args.count();

  lp(let i=1;i<(argc as i64);i=i+1){
    let arg=args.get(i);
    if(arg="--http"){
      httpmode=true
    };
    if(arg="--port"){
      if((i+1)<(argc as i64)){
        let nxt=args.get(i+1);
        let v=mt str.toint(nxt) {
          $ok:n n;
          $err:e 443
        };
        port=v as u64;
        i=i+1
      }
    }
  };

  let hj=healthjson();
  http.getstaticmime("/health"; hj; "application/json");
  http.getstaticmime("/api/health"; hj; "application/json");
  http.postjson("/api/health"; hj);
  http.getstatic("/api/version"; "{\"version\":\"0.1.0\"}");

  if(httpmode){
    http.servedir("/"; "sites/tokelang.dev");
    io.println(str.concat("http mode on port "; str.fromint(port as i64)));
    http.serveworkers(port; 2)
  };
  if(httpmode=false){
    http.vhost("tokelang.dev"; "sites/tokelang.dev");
    http.vhost("www.tokelang.dev"; "sites/tokelang.dev");
    http.vhost("staging.tokelang.dev"; "sites/tokelang.dev");
    http.vhost("loke.tokelang.dev"; "sites/loke.tokelang.dev");
    http.servevhoststls(port; "certs/cert.pem"; "certs/key.pem")
  };
  <0
};

m=website;
i=http:std.http;
i=log:std.log;
i=args:std.args;
i=str:std.str;
i=io:std.io;
i=file:std.file;

f=healthjson():$str{
  <"{\"status\":\"ok\",\"version\":\"0.3.0\",\"service\":\"toke-website\"}"
};

f=main():i64{
  log.openaccess("logs/access.log"; 10000; 30; 0);

  let port=mut.443 as u64;
  let httpmode=mut.false;
  let argc=args.count();

  lp(let i=1;i<(argc as i64);i=i+1){
    let arg=args.get(i as u64);
    if(arg="--http"){
      httpmode=true
    };
    if(arg="--port"){
      let nxt=args.get((i+1) as u64);
      let v=mt str.toint(nxt) {$ok:n n;$err:e 443};
      port=v as u64;
      i=i+1
    }
  };

  let hj=healthjson();
  http.getstaticmime("/health"; hj; "application/json");
  http.getstaticmime("/api/health"; hj; "application/json");
  http.getstatic("/api/version"; "{\"version\":\"0.3.0\"}");

  let idx=mt file.read("build/index.html") {$ok:v v;$err:e ""};
  http.getstatic("/";idx);
  let css=mt file.read("build/static/css/style.css") {$ok:v v;$err:e ""};
  http.getstaticmime("/static/css/style.css";css;"text/css");

  let pages=@("/docs";"/docs/learn";"/docs/reference";"/docs/learn/01-why-toke";"/docs/learn/02-modules-functions";"/docs/learn/03-control-flow";"/about";"/about/why";"/about/design";"/ecosystem";"/loke";"/ooke";"/docs/guide";"/docs/guide/tour";"/docs/stdlib";"/docs/tutorials";"/docs/compiler";"/docs/cookbook";"/docs/decisions";"/docs/spec");
  lp(let pi=0;pi<pages.len;pi=pi+1){
    let p=pages.get(pi);
    let fpath=str.concat("build";str.concat(p;"/index.html"));
    let html=mt file.read(fpath) {$ok:v v;$err:e ""};
    http.getstatic(p;html)
  };

  http.vhost("tokelang.dev"; "sites/tokelang.dev");
  http.vhost("www.tokelang.dev"; "sites/tokelang.dev");
  http.vhost("staging.tokelang.dev"; "sites/tokelang.dev");
  http.vhost("loke.tokelang.dev"; "sites/loke.tokelang.dev");

  http.servedir("/static";"build");

  if(httpmode){
    http.serveworkers(port; 2)
  };
  if(httpmode=false){
    http.servevhoststls(port; "certs/cert.pem"; "certs/key.pem")
  };
  <0
};

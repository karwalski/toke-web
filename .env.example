# Lightsail deployment configuration
# Copy to .env and fill in your values:
#   cp .env.example .env

LIGHTSAIL_HOST=0.0.0.0          # Public IP of your Lightsail instance
LIGHTSAIL_USER=bitnami           # SSH user (default for Bitnami images)
LIGHTSAIL_KEY=~/.ssh/lightsail-tokelang.pem   # Path to SSH private key
DOMAIN=tokelang.dev              # Your domain name

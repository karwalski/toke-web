<!-- Tab switching script -->
<script>
document.querySelectorAll('.tv-tab-bar').forEach(function(bar) {
  bar.addEventListener('click', function(e) {
    var btn = e.target.closest('.tv-tab-btn');
    if (!btn) return;
    var tabs = bar.closest('.tv-tabs');
    tabs.querySelectorAll('.tv-tab-btn').forEach(function(b) { b.classList.remove('active'); });
    tabs.querySelectorAll('.tv-tab-panel').forEach(function(p) { p.classList.remove('active'); });
    btn.classList.add('active');
    var panel = document.getElementById(btn.getAttribute('data-tab'));
    if (panel) panel.classList.add('active');
  });
});
</script>

{! end !}

</span><span class="tv-tok tv-c2">       </span><span class="tv-tok tv-c3"> System</span><span class="tv-tok tv-c4">.out</span><span class="tv-tok tv-c5">.println</span><span class="tv-tok tv-c6">(f</span><span class="tv-tok tv-c7">ib</span><span class="tv-tok tv-c8">(</span><span class="tv-tok tv-c9">10</span><span class="tv-tok tv-c10">));&#x21B5;
</span><span class="tv-tok tv-c11">   </span><span class="tv-tok tv-c0"> }&#x21B5;

<!-- Token Efficiency: Real Numbers                                      -->
<!-- ================================================================== -->

<div class="section-alt" style="background:#0d0d0d;padding:3rem 2rem;margin:2rem 0;">
  <div style="max-width:900px;margin:0 auto;">
    <h2 style="text-align:center;margin-bottom:0.5rem;">Token Efficiency: Measured, Not Claimed</h2>
    <p style="text-align:center;color:#888;margin-bottom:2rem;font-size:0.9rem;">Purpose-built BPE tokenizer (16K vocab) trained on 25,953 toke programs. Compared against cl100k_base (100K vocab, used by GPT-4 and Claude).</p>

    <div style="display:flex;gap:2rem;justify-content:center;flex-wrap:wrap;margin-bottom:2rem;">
      <div style="text-align:center;padding:1.5rem 2rem;background:#111;border:1px solid #222;border-radius:8px;">
        <div style="font-size:2.5rem;font-weight:700;color:#82e0aa;">52%</div>
        <div style="font-size:0.75rem;color:#888;margin-top:0.3rem;">AVERAGE TOKEN REDUCTION</div>
        <div style="font-size:0.7rem;color:#555;">vs cl100k on 42 benchmark programs</div>
      </div>
      <div style="text-align:center;padding:1.5rem 2rem;background:#111;border:1px solid #222;border-radius:8px;">
        <div style="font-size:2.5rem;font-weight:700;color:#c792ea;">24</div>
        <div style="font-size:0.75rem;color:#888;margin-top:0.3rem;">TOKENS: FIBONACCI</div>
        <div style="font-size:0.7rem;color:#555;">vs 61 in cl100k (61% reduction)</div>
      </div>
      <div style="text-align:center;padding:1.5rem 2rem;background:#111;border:1px solid #222;border-radius:8px;">
        <div style="font-size:2.5rem;font-weight:700;color:#f0c040;">9</div>
        <div style="font-size:0.75rem;color:#888;margin-top:0.3rem;">TOKENS: HELLO WORLD</div>
        <div style="font-size:0.7rem;color:#555;">vs 26 in cl100k (65% reduction)</div>
      </div>
    </div>

    <p style="text-align:center;color:#888;font-size:0.85rem;">Patterns like <code style="background:#161616;border:1px solid #222;border-radius:3px;padding:0.15em 0.35em;font-size:0.82em;color:#c792ea;">f=main():i64{</code>, <code style="background:#161616;border:1px solid #222;border-radius:3px;padding:0.15em 0.35em;font-size:0.82em;color:#c792ea;">i=j:std.json</code>, and <code style="background:#161616;border:1px solid #222;border-radius:3px;padding:0.15em 0.35em;font-size:0.82em;color:#c792ea;">){&lt;n};&lt;</code> merge into single tokens because the BPE was trained on real toke code.</p>

    <div style="text-align:center;margin-top:1.5rem;display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <a href="/tokenizer" style="background:#2a1a3a;border:1px solid #c792ea;color:#c792ea;padding:0.6rem 1.2rem;border-radius:6px;text-decoration:none;font-size:0.85rem;font-weight:600;">Try the Live Tokenizer &rarr;</a>
      <a href="/tokens" style="background:#1a1a1a;border:1px solid #333;color:#aaa;padding:0.6rem 1.2rem;border-radius:6px;text-decoration:none;font-size:0.85rem;">Token Visualisation Gallery</a>
      <a href="/docs/reference/token-comparison" style="background:#1a1a1a;border:1px solid #333;color:#aaa;padding:0.6rem 1.2rem;border-radius:6px;text-decoration:none;font-size:0.85rem;">Full 42-Example Comparison</a>
    </div>
  </div>
</div>


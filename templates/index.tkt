</span><span class="tv-tok tv-c2">int</span><span class="tv-tok tv-c3"> main</span><span class="tv-tok tv-c4">(void</span><span class="tv-tok tv-c5">)</span><span class="tv-tok tv-c6"> {&#x21B5;
</span><span class="tv-tok tv-c7">   </span><span class="tv-tok tv-c8"> printf</span><span class="tv-tok tv-c9">(&quot;%</span><span class="tv-tok tv-c10">ld</span><span class="tv-tok tv-c11">\n</span><span class="tv-tok tv-c0">&quot;,</span><span class="tv-tok tv-c1"> fib</span><span class="tv-tok tv-c2">(</span><span class="tv-tok tv-c3">10</span><span class="tv-tok tv-c4">));&#x21B5;
</span><span class="tv-tok tv-c5">   </span><span class="tv-tok tv-c6"> return</span><span class="tv-tok tv-c7"> </span><span class="tv-tok tv-c8">0</span><span class="tv-tok tv-c9">;&#x21B5;
</span><span class="tv-tok tv-c10">}</span></code></pre>

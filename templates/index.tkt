&#x21B5;
</span><span class="tv-tok tv-c5">long</span><span class="tv-tok tv-c6"> fib</span><span class="tv-tok tv-c7">(long</span><span class="tv-tok tv-c8"> n</span><span class="tv-tok tv-c9">)</span><span class="tv-tok tv-c10"> {&#x21B5;
</span><span class="tv-tok tv-c11">   </span><span class="tv-tok tv-c0"> if</span><span class="tv-tok tv-c1"> (</span><span class="tv-tok tv-c2">n</span><span class="tv-tok tv-c3"> &lt;</span><span class="tv-tok tv-c4"> </span><span class="tv-tok tv-c5">2</span><span class="tv-tok tv-c6">)</span><span class="tv-tok tv-c7"> return</span><span class="tv-tok tv-c8"> n</span><span class="tv-tok tv-c9">;&#x21B5;
</span><span class="tv-tok tv-c10">   </span><span class="tv-tok tv-c11"> return</span><span class="tv-tok tv-c0"> fib</span><span class="tv-tok tv-c1">(n</span><span class="tv-tok tv-c2"> -</span><span class="tv-tok tv-c3"> </span><span class="tv-tok tv-c4">1</span><span class="tv-tok tv-c5">)</span><span class="tv-tok tv-c6"> +</span><span class="tv-tok tv-c7"> fib</span><span class="tv-tok tv-c8">(n</span><span class="tv-tok tv-c9"> -</span><span class="tv-tok tv-c10"> </span><span class="tv-tok tv-c11">2</span><span class="tv-tok tv-c0">);&#x21B5;

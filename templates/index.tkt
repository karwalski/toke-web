</span><span class="tv-tok tv-c8">   </span><span class="tv-tok tv-c9"> return</span><span class="tv-tok tv-c10"> fib</span><span class="tv-tok tv-c11">(n</span><span class="tv-tok tv-c0"> -</span><span class="tv-tok tv-c1"> </span><span class="tv-tok tv-c2">1</span><span class="tv-tok tv-c3">)</span><span class="tv-tok tv-c4"> +</span><span class="tv-tok tv-c5"> fib</span><span class="tv-tok tv-c6">(n</span><span class="tv-tok tv-c7"> -</span><span class="tv-tok tv-c8"> </span><span class="tv-tok tv-c9">2</span><span class="tv-tok tv-c10">)&#x21B5;
&#x21B5;
</span><span class="tv-tok tv-c11">print</span><span class="tv-tok tv-c0">(f</span><span class="tv-tok tv-c1">ib</span><span class="tv-tok tv-c2">(</span><span class="tv-tok tv-c3">10</span><span class="tv-tok tv-c4">))</span></code></pre>

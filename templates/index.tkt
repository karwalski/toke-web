</span><span class="tv-tok tv-c0">int</span><span class="tv-tok tv-c1"> main</span><span class="tv-tok tv-c2">(void</span><span class="tv-tok tv-c3">)</span><span class="tv-tok tv-c4"> {&#x21B5;
</span><span class="tv-tok tv-c5">   </span><span class="tv-tok tv-c6"> long</span><span class="tv-tok tv-c7"> result</span><span class="tv-tok tv-c8"> =</span><span class="tv-tok tv-c9"> fibonacci</span><span class="tv-tok tv-c10">(</span><span class="tv-tok tv-c11">10</span><span class="tv-tok tv-c0">);&#x21B5;
</span><span class="tv-tok tv-c1">   </span><span class="tv-tok tv-c2"> printf</span><span class="tv-tok tv-c3">(&quot;%</span><span class="tv-tok tv-c4">ld</span><span class="tv-tok tv-c5">\n</span><span class="tv-tok tv-c6">&quot;,</span><span class="tv-tok tv-c7"> result</span><span class="tv-tok tv-c8">);&#x21B5;
</span><span class="tv-tok tv-c9">   </span><span class="tv-tok tv-c10"> return</span><span class="tv-tok tv-c11"> </span><span class="tv-tok tv-c0">0</span><span class="tv-tok tv-c1">;&#x21B5;
</span><span class="tv-tok tv-c2">}</span></code></pre>
